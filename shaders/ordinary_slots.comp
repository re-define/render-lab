#version 460
#include "scene_slots.glsl"
layout(local_size_x=64) in;
struct Draw { uvec4 slots; uvec4 geometry; };
struct Item { mat4 model; SceneMaterial material; uvec4 geometry; };
layout(set=0,binding=0,std430) readonly buffer Draws { Draw draws[]; };
layout(set=0,binding=1,std430) readonly buffer Transforms { SceneModel models[]; };
layout(set=0,binding=2,std430) readonly buffer Materials { SceneMaterial materials[]; };
layout(set=0,binding=3,std430) readonly buffer Overrides { SceneMaterial overrides[]; };
layout(set=0,binding=4,std430) writeonly buffer Surfaces { Item items[]; };
layout(push_constant) uniform Params { layout(offset=20) uint base; uint count; } p;
void main() {
    uint i = gl_GlobalInvocationID.x + gl_WorkGroupID.y * 32768u * 64u;
    if (i >= p.count) return;
    Draw draw = draws[i];
    mat4 model = mat4(1.0);
    if (draw.slots.x != 0xffffffffu) model = models[draw.slots.x].model;
    SceneMaterial material = materials[draw.slots.y];
    if (draw.slots.w != 0xffffffffu) material = overrides[draw.slots.w];
    material.tex.w |= draw.slots.z;
    items[p.base+i] = Item(model, material, draw.geometry);
}
