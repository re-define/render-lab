#version 460
#define GI_MATERIALS 9
#define GI_TEXELS 10
#define LIGHTING_CONFIG 5
#define LIGHTING_NODES 6
#define LIGHTING_TRIANGLES 7
#include "lighting_scene.glsl"
#include "lighting_rays.glsl"
#include "lighting_probes.glsl"
#include "visibility_image.glsl"
struct Object { mat4 model; vec4 color; vec4 params; uvec4 tex; uvec4 routing; uvec4 refs; };
layout(set=0,binding=1,std430) readonly buffer Objects { Object objects[]; };
layout(set=0,binding=2,std430) readonly buffer Direct { LightingPixel lightPixels[]; };
layout(set=0,binding=3,std430) writeonly buffer Indirect { vec4 bounce[]; };
layout(set=0,binding=4,std430) readonly buffer Camera { mat4 vp; vec4 eye; uvec2 screen; };
layout(set=0,binding=8,std430) readonly buffer Probes { Probe probes[]; };
layout(local_size_x=8,local_size_y=8) in;

vec3 screenBounce(vec3 origin, vec3 ray, float jitter) {
    for(int step=0;step<16;++step){
        float progress=(float(step)+jitter)/16.0;
        vec3 p=origin+ray*(0.10+4.8*progress*progress);
        vec4 clip=vp*vec4(p,1.0);
        if(clip.w<=0.0) break;
        vec2 uv=clip.xy/clip.w*0.5+0.5;
        if(any(lessThan(uv,vec2(0))) || any(greaterThanEqual(uv,vec2(1)))) break;
        uvec2 xy=uvec2(uv*vec2(screen));
        uint i=xy.y*screen.x+xy.x;
        LightingPixel receiver=lightPixels[i];
        if(receiver.position.w==0.0) continue;
        float delta=clip.w-receiver.position.w;
        if(delta<0.025 || delta>0.19) continue;
        if(distance(receiver.position.xyz,p)>0.33 || dot(receiver.normal.xyz,ray)>-0.04) continue;
        Object obj=objects[visibilityAt(xy).x-1u];
        if(obj.params.w==1.0) return vec3(0); // the direct pass already integrates the light
        return obj.color.rgb*receiver.direct.rgb;
    }
    return vec3(0);
}

vec3 interpolateProbes(vec3 origin, vec3 n) {
    vec3 q=clamp((origin-probeMin)/probeStep,vec3(0),vec3(probeDims-1));
    ivec3 base=min(ivec3(q),probeDims-2);
    vec3 f=q-vec3(base);
    vec4 sum=vec4(0);
    for(int i=0;i<8;++i){
        ivec3 corner=ivec3(i&1,(i>>1)&1,(i>>2)&1);
        ivec3 cell=base+corner;
        vec3 w=mix(1.0-f,f,vec3(corner));
        float weight=w.x*w.y*w.z;
        if(weight<0.0001) continue;
        vec3 target=probeMin+vec3(cell)*probeStep;
        if(dot(target-origin,n)<-0.035) continue;
        if(sampleVisibility(origin,n,target)==0.0) continue;
        Probe probe=probes[probeIndex(cell)];
        vec3 sampleColor=probe.lobe[n.x<0.0 ? 1 : 0].rgb*n.x*n.x
                        +probe.lobe[n.y<0.0 ? 3 : 2].rgb*n.y*n.y
                        +probe.lobe[n.z<0.0 ? 5 : 4].rgb*n.z*n.z;
        sum+=vec4(weight*sampleColor,weight);
    }
    return sum.rgb/max(sum.w,0.0001);
}

void main() {
    uvec2 halfExtent=(screen+1u)/2u;
    uvec2 low=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(low,halfExtent))) return;
    uvec2 xy=min(low*2u+1u,screen-1u);
    uint i=xy.y*screen.x+xy.x;
    LightingPixel source=lightPixels[i];
    vec3 sum=vec3(0);
    if(source.position.w>0.0 && objects[visibilityAt(xy).x-1u].params.w!=1.0){
        uint seed=hash(i+7727u);
        vec3 origin=source.position.xyz+source.normal.xyz*0.013;
        if(modes.y==3u){
            sum=interpolateProbes(origin,source.normal.xyz);
        }else{
            int count=modes.y==1u ? 6 : 16;
            for(int j=0;j<count;++j){
                vec3 ray=cosineDirection(source.normal.xyz,seed);
                sum+=modes.y==1u ? screenBounce(origin,ray,random(seed)) : worldBounce(origin,ray,seed);
            }
            sum/=float(count);
        }
    }
    bounce[low.y*halfExtent.x+low.x]=vec4(sum,0);
}
