#version 460
#extension GL_EXT_ray_tracing : require
#include "lighting_scene.glsl"
#include "restir_types.glsl"
#define RESTIR_CONFIG 2
#define RESTIR_HISTORY 3
#include "restir_controls.glsl"
#include "restir_history.glsl"
#include "restir_lights.glsl"
layout(binding=0,std430) readonly buffer Current {Surface surfaces[];};
layout(binding=4,std430) readonly buffer Reservoirs {Reservoir selected[];};
layout(binding=5,std430) writeonly buffer Output {Radiance raw[];};
#ifdef PROXY_SHADOWS
#define TLAS_OFFSET 24
#else
#define TLAS_OFFSET 32
#endif
#define SCENE_RAY_HARDWARE
#include "scene_ray_query.glsl"
#include "restir_visibility.glsl"
#include "restir_shadow_eval.glsl"
void main(){evaluateShadow(gl_LaunchIDEXT.xy);}
