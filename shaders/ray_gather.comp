#version 460
#include "lighting_scene.glsl"
layout(local_size_x=64) in;
layout(binding=0,std430) readonly buffer Vertices {vec4 vertices[];};
layout(binding=1,std430) readonly buffer Faces {uvec4 faces[];};
layout(binding=2,std430) writeonly buffer Output {Triangle triangles[];};
layout(push_constant) uniform Params {layout(offset=16) mat4 model; vec4 color; uint first;uint count;uint materialSlot;} p;
void main(){
    uint i=gl_GlobalInvocationID.x+gl_WorkGroupID.y*32768u*64u;
    if(i>=p.count)return;
    Triangle t;
    mat3 normals=transpose(inverse(mat3(p.model)));
    for(uint j=0;j<3;++j){
        uint v=faces[i][j];
        t.point[j]=p.model*vec4(vertices[2*v].xyz,1.);
        vec3 n=normals*vertices[2*v+1].xyz;
        t.point[j].w=vertices[2*v].w;
        t.normal[j]=vec4(dot(n,n)>1e-16?normalize(n):vec3(0),vertices[2*v+1].w);
    }
    t.color=p.color;
    t.material=uvec4(p.materialSlot==0xffffffffu ? faces[i].w : p.materialSlot,0,0,0);
    triangles[p.first+i]=t;
}
