#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer BindVertices { vec4 inputVertices[]; };
struct Influence { uvec4 joints; vec4 weights; };
layout(set=0,binding=1,std430) readonly buffer Weights { Influence influences[]; };
layout(set=0,binding=2,std430) readonly buffer Pose { mat4 matrices[]; };
layout(buffer_reference,std430,buffer_reference_align=16) writeonly buffer PosedVertices { vec4 values[]; };
layout(set=0,binding=3,std430) readonly buffer Destinations { uvec2 destinations[]; };
struct SkinJob { mat4 model; mat4 root; uvec4 offset; };
layout(set=0,binding=4,std430) readonly buffer Jobs { SkinJob jobs[]; };
layout(push_constant) uniform Params { layout(offset=20) uint count; } p;

void main() {
    uint i=(gl_WorkGroupID.x+32768u*gl_WorkGroupID.y)*64u+gl_LocalInvocationID.x;
    if(i>=p.count) return;
    uint base=jobs[gl_WorkGroupID.z].offset.x;
    PosedVertices outputVertices=PosedVertices(destinations[gl_WorkGroupID.z]);
    Influence skin=influences[i];
    mat4 blend=mat4(0);
    float total=0.0;
    for(int j=0;j<4;++j){
        if(skin.weights[j]!=0.0){
            blend+=matrices[base+skin.joints[j]]*skin.weights[j];
            total+=skin.weights[j];
        }
    }
    mat4 transform=total>0.0 ? jobs[gl_WorkGroupID.z].root * (blend*(1.0/total)) : jobs[gl_WorkGroupID.z].model;
    vec4 position=inputVertices[2u*i];
    vec3 posed=(transform*vec4(position.xyz,1.0)).xyz;
#ifdef POSITION_ONLY
    outputVertices.values[i]=vec4(posed,1.0);
#else
    vec4 normal=inputVertices[2u*i+1u];
    vec3 n=transpose(inverse(mat3(transform)))*normal.xyz;
    float scale=inversesqrt(dot(n,n));
    n=scale>0.0 && !isinf(scale) ? n*scale : vec3(0);
    outputVertices.values[2u*i]=vec4(posed,position.w);
    outputVertices.values[2u*i+1u]=vec4(n,normal.w);
#endif
}
