#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_NV_cluster_acceleration_structure : require
#include "cluster.glsl"
#include "cluster_coverage.glsl"
#include "cluster_hit.glsl"
layout(binding=0,std430) readonly buffer Ids {uvec2 ids[];};
layout(binding=2,std430) readonly buffer Coverage {uvec4 metadata[];};
layout(binding=3,std430) readonly buffer Camera {View view;};
layout(location=0) rayPayloadInEXT uint missed;
void main(){
    uint slot=uint(gl_ClusterIDNV);
    if(slot==0u || slot>=metadata.length())ignoreIntersectionEXT;
    uvec2 target=ids[gl_LaunchIDEXT.x+gl_LaunchSizeEXT.x*gl_LaunchIDEXT.y];
    uvec2 transition=metadata[slot].xy;
    if(target!=uvec2(transition.y+1u,(metadata[slot].z<<6u)|uint(gl_PrimitiveID)) || !coveredHit(transition,view))ignoreIntersectionEXT;
    missed=0u;
    terminateRayEXT;
}
