#version 460
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) readonly buffer Linear { vec4 lighting[]; };
layout(set=0,binding=1,std430) writeonly buffer Display { uint pixels[]; };
layout(push_constant) uniform Params { layout(offset=8) uvec2 extent; } p;
void main() {
    uvec2 pos=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(pos,p.extent))) return;
    uint i=pos.y*p.extent.x+pos.x;
    vec3 x=max(lighting[i].xyz,0.0);
    vec3 tone=clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14),0.0,1.0);
    pixels[i]=packUnorm4x8(vec4(pow(tone.bgr,vec3(1.0/2.2)),1.0));
}
