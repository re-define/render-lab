#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_NV_cluster_acceleration_structure : require
#include "cluster.glsl"
#include "cluster_coverage.glsl"
#ifdef GI_SHADOW
#define META_BINDING 11
#define VIEW_BINDING 12
#else
#define META_BINDING 6
#define VIEW_BINDING 7
#endif
layout(binding=META_BINDING,std430) readonly buffer Coverage {uvec4 metadata[];};
layout(binding=VIEW_BINDING,std430) readonly buffer Camera {View view;};
#include "cluster_hit.glsl"
void main(){
    if(!coveredHit(metadata[gl_ClusterIDNV].xy,view))ignoreIntersectionEXT;
}
