#version 460
layout(local_size_x=8, local_size_y=8) in;
#include "visibility_image.glsl"
layout(set=0, binding=1, std430) buffer Shaded { uint pixels[]; };
layout(push_constant) uniform Params {
    layout(offset=8) uvec2 size;
    uvec2 origin;
    uvec2 area;
    vec2 points[10];
} p;

float segment_distance(vec2 pixel, vec2 start, vec2 end) {
    vec2 segment = end - start;
    float t = clamp(dot(pixel - start, segment) / max(dot(segment, segment), 1e-6), 0., 1.);
    return length(pixel - (start + t * segment));
}

void main() {
    uvec2 local = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(local, p.area))) return;
    uvec2 xy = p.origin + local;
    uint index = xy.y * p.size.x + xy.x;
    uvec2 renderPixel = uvec2((vec2(xy) + .5) * vec2(textureSize(visibilityImage, 0)) / vec2(p.size));
    if (visibilityAt(renderPixel).x != 0u) return;

    vec2 pixel = vec2(xy) + 0.5;
    float ink = length(pixel - p.points[0]) - 4.0;
    for (int i = 1; i < 10; ++i) {
        ink = min(ink, segment_distance(pixel, p.points[i - 1], p.points[i]) - 1.8);
        if (i % 3 == 0) ink = min(ink, length(pixel - p.points[i]) - (i == 9 ? 6.0 : 4.5));
    }
    if (ink >= 2.0) return;
    const vec4 outline = vec4(0.12, 0.16, 0.22, 1.);
    const vec4 path = vec4(0.12, 0.74, 0.96, 1.);
    vec4 shaded = unpackUnorm4x8(pixels[index]);
    shaded = mix(shaded, outline.bgra, 1. - smoothstep(1., 2., ink));
    pixels[index] = packUnorm4x8(mix(shaded, path.bgra, 1. - smoothstep(-0.5, 0.5, ink)));
}
