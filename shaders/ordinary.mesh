#version 460
#extension GL_EXT_mesh_shader : require
#include "ordinary_draw.glsl"
layout(local_size_x=32) in;
layout(triangles,max_vertices=96,max_primitives=32) out;
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Faces { uvec4 data[]; };
layout(set=0,binding=2,std430) readonly buffer FaceAddresses { uvec2 faces[]; };
layout(set=0,binding=3,std430) readonly buffer Ends { uint ends[]; };
layout(push_constant) uniform Params { layout(offset=16) uint surfaces; } p;
layout(location=0) perprimitiveEXT flat out uvec2 id[];
void main() {
    uint group = gl_WorkGroupID.x;
    uint lo = 0u, hi = p.surfaces;
    while (lo < hi) {
        uint mid = (lo+hi)/2u;
        if (ends[mid] <= group) lo = mid+1u;
        else hi = mid;
    }
    uint slot=lo;
    DrawRecord draw=draws[slot];
    uint first=(group-(slot==0u ? 0u : ends[slot-1u]))*32u;
    uint count=min(draw.info.y-first,32u);
    SetMeshOutputsEXT(3u*count,count);
    uint lane=gl_LocalInvocationID.x;
    if (lane>=count) return;
    uint tri=first+lane;
    uvec3 indices=Faces(faces[slot]).data[tri].xyz;
    for(uint j=0u; j<3u; ++j) {
        vec3 position=Vertices(vertices[slot]).data[2u*indices[j]].xyz;
        gl_MeshVerticesEXT[3u*lane+j].gl_Position=draw.clipFromVertex*vec4(position,1.0);
    }
    gl_PrimitiveTriangleIndicesEXT[lane]=uvec3(3u*lane)+uvec3(0,1,2);
    id[lane]=uvec2(draw.info.x+1u,tri);
}
