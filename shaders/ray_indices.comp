#version 460
layout(local_size_x=64) in;
layout(binding=0,std430) readonly buffer Source { uvec4 faces[]; };
layout(binding=1,std430) writeonly buffer Packed { uint indices[]; };
layout(push_constant) uniform Params { layout(offset=8) uint count; } p;
void main(){
    uint i=gl_GlobalInvocationID.x+gl_WorkGroupID.y*32768u*64u;
    if(i<p.count)for(uint j=0;j<3;++j)indices[3*i+j]=faces[i][j];
}
