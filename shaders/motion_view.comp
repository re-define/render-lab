#version 460
#include "motion.glsl"

layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) readonly buffer Motion { MotionSample samples[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { uint pixels[]; };
layout(push_constant) uniform Viewport { layout(offset=8) uvec2 extent; };

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(xy,extent))) return;
    uint i = xy.y*extent.x + xy.x;
    MotionSample s = samples[i];
    vec3 rgb = s.previousDepth < 0.0 ? vec3(1.0,0.05,0.65)
        : vec3(0.5 + s.offset/32.0,min(length(s.offset)/16.0,1.0));
    pixels[i] = packUnorm4x8(vec4(rgb.bgr,1.0));
}
