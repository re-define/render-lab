#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "surface.glsl"
#include "restir_types.glsl"
layout(set=0,binding=2,std430) writeonly buffer Surfaces { Surface surfaces[]; };
layout(local_size_x=8,local_size_y=8) in;
void main(){
    uvec2 xy=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(xy,screen))) return;
    uint pixel=xy.y*screen.x+xy.x;
    uvec2 vis=visibilityAt(xy);
    if(vis.x==0u || items[vis.x-1u].obj.params.w==1.0) {
        surfaces[pixel]=Surface(vec4(0),vec2(0),0.,0u);
        return;
    }
    mat3x4 clip; mat3 positions,normals; mat3x2 uv; uint mask;
    surfaceTriangle(items[vis.x-1u],vis.y,xy,clip,positions,normals,uv,mask);
    vec3 b=barycentric(clip,(vec2(xy)+0.5)*2.0/vec2(screen)-1.0);
    vec3 p=positions*b, n=normals*b;
    if(dot(n,n)<1e-10) n=cross(positions[1]-positions[0],positions[2]-positions[0]);
    n=normalize(n);
    if(dot(n,eye.xyz-p)<0.0) n=-n;
    vec4 point=vec4(p,(vp*vec4(p,1.0)).w);
#ifdef PROBE_BARYCENTRIC
    surfaces[pixel]=Surface(point,b.xy,0.,vis.x);
#else
    bool leaf=foliageLod(items[vis.x-1u].obj);
    surfaces[pixel]=makeReceiver(point,n,vis.x,leaf,receiverSky(n,leaf,(uv*b).x));
#endif
}
