#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=32) in;
layout(triangles, max_vertices=96, max_primitives=32) out;
#include "outline.glsl"
layout(push_constant) uniform Params { layout(offset=12) uint count; } p;
void main() {
    uint first = 32u * groupIndex(), n = min(p.count - min(first, p.count), 32u);
    SetMeshOutputsEXT(3u * n, n);
    uint lane = gl_LocalInvocationID.x;
    if (lane >= n) return;
    uvec3 tri = faces[first + lane].xyz;
    vec3 a = position(tri.x), b = position(tri.y), c = position(tri.z);
    for (uint i = 0; i < 3; ++i) {
        vec4 clip = vp * vec4(position(tri[i]), 1);
        vec3 normal = vertices[2u * tri[i] + 1u].xyz;
        if (dot(normal, normal) < 1e-10) normal = cross(b - a, c - a);
        vec4 delta = vp * vec4(normal, 0);
        vec2 direction = unitOrZero((delta.xy * clip.w - clip.xy * delta.w) * screen);
        gl_MeshVerticesEXT[3u * lane + i].gl_Position = expandPixel(clip, direction);
    }
    gl_PrimitiveTriangleIndicesEXT[lane] = 3u * lane + uvec3(0,1,2);
    gl_MeshPrimitivesEXT[lane].gl_CullPrimitiveEXT = front(a,b,c);
    id[lane] = uvec2(0,1);
}
