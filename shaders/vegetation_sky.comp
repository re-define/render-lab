#version 460
#include "visibility_image.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1) uniform texture2D sceneDepth;
#define SCENE_COLOR_BINDING 2
#include "effect_color.glsl"
layout(set=0,binding=3,std430) readonly buffer View {
    mat4 inverseVP;
    vec4 eye;
    vec4 sun;
    uvec4 params;
    mat4 vp;
};

// Contact shadows resolve thin nearby blades against the bank and neighbouring leaves.
float contact(vec3 world,float eyeDistance) {
    if(params.w!=1u || sun.w<=0.0 || eyeDistance>42.)return 0.;
    float shadow=0.;
    for(int i=0;i<7;++i){
        float stepLength=.07*pow(1.75,float(i));
        vec3 samplePos=world+sun.xyz*stepLength;
        vec4 clip=vp*vec4(samplePos,1.);
        if(clip.w<=0.)break;
        vec2 uv=clip.xy/clip.w*.5+.5;
        if(any(lessThan(uv,vec2(0)))||any(greaterThanEqual(uv,vec2(1))))break;
        ivec2 xy=ivec2(uv*vec2(params.xy));
        float z=texelFetch(sceneDepth,xy,0).x;
        vec4 hit=inverseVP*vec4((vec2(xy)+.5)*2./vec2(params.xy)-1.,z,1.);
        float gap=length(samplePos-eye.xyz)-length(hit.xyz/hit.w-eye.xyz);
        float bias=.024+.0013*eyeDistance;
        float thickness=bias+.14+.15*stepLength;
        shadow=max(shadow,smoothstep(bias,bias+.045,gap)*(1.-smoothstep(thickness,thickness+.12,gap)));
    }
    return shadow*(1.-smoothstep(21.,42.,eyeDistance))*sun.w;
}
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(xy,params.xy))) return;
    uint index=xy.y*params.x+xy.x;
    vec2 ndc=(vec2(xy)+0.5)*2.0/vec2(params.xy)-1.0;
    float depth=texelFetch(sceneDepth,ivec2(xy),0).x;
    vec4 p=inverseVP*vec4(ndc,min(depth,0.99999),1.0);
    vec3 delta=p.xyz/p.w-eye.xyz;
    vec3 ray=normalize(delta);
    float high=pow(max(0.0,ray.y),0.52);
    bool valley=params.w==2u;
    vec3 horizon=valley ? vec3(0.55,0.67,0.71) : vec3(0.765,0.842,0.851);
    vec3 sky=mix(horizon,vec3(0.32,0.54,0.73),clamp(high,0.0,1.0));
    float glow=pow(max(0.0,dot(ray,sun.xyz)),18.0)*sun.w;
    sky+=vec3(0.18,0.116,0.039)*glow;
    if(visibilityAt(xy).x==0u){
        if ((params.z & 2u) == 0u) storeSceneColor(index, authoredColor(sky));
    }else if((params.z & 1u)==0u){
        vec3 color=loadSceneColor(index);
        color*=mix(vec3(1.),vec3(.67,.74,.82),contact(p.xyz/p.w,length(delta)));
        float mist=0.65*(1.0-exp(-(valley ? 0.0029 : 0.0045)*max(0.0,length(delta)-12.0)));
        storeSceneColor(index, mix(color,authoredColor(horizon+vec3(0.035,0.018,0.0)*glow),mist));
    }
}
